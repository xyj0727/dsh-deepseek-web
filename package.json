{
  "name": "@local/dsh-deepseek-web",
  "version": "2.1.0",
  "description": "DeepSeek Chat and Grok as full-bleed main panels in the DeepSeek Harness desktop app: chrome-less webviews on chat.deepseek.com and grok.com with persistent logins",
  "type": "module",
  "license": "MIT",
  "author": "xyj0727",
  "homepage": "https://github.com/xyj0727/dsh-deepseek-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyj0727/dsh-deepseek-web.git"
  },
  "bugs": {
    "url": "https://github.com/xyj0727/dsh-deepseek-web/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "deepseek",
    "grok",
    "webview",
    "electron",
    "chat"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "icon-grok.png",
    "patch-dsh.cjs"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
